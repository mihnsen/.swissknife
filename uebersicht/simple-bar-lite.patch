diff --git a/lib/components/claude.jsx b/lib/components/claude.jsx
new file mode 100644
index 0000000..ed3cfbe
--- /dev/null
+++ b/lib/components/claude.jsx
@@ -0,0 +1,89 @@
+import * as Uebersicht from 'uebersicht'
+import * as Settings from '../services/settings'
+import * as Json from '../services/json'
+import * as Output from '../services/output'
+import * as ClassNames from '../services/classnames'
+import Widget from './widget.jsx'
+import useWidgetRefresh from '../hooks/use-widget-refresh'
+
+const settings = Settings.get()
+const { claude } = settings.dataWidgets
+const { color, onClickCommand, refreshOnClick, refreshFrequency, warnAt, dangerAt } = claude
+
+const command = '/usr/bin/python3 simple-bar-lite/lib/scripts/claude-status.py'
+
+const formatElapsed = (seconds) => {
+  if (seconds == null) return ''
+  if (seconds < 60) return `${seconds}s`
+  if (seconds < 3600) return `${Math.floor(seconds / 60)}m${String(seconds % 60).padStart(2, '0')}s`
+  return `${Math.floor(seconds / 3600)}h${String(Math.floor((seconds % 3600) / 60)).padStart(2, '0')}m`
+}
+
+const formatReset = (iso) => {
+  if (!iso) return ''
+  const minutes = Math.max(0, Math.round((new Date(iso) - Date.now()) / 60000))
+  if (minutes < 60) return `${minutes}m`
+  if (minutes < 1440) return `${Math.floor(minutes / 60)}h${String(minutes % 60).padStart(2, '0')}m`
+  return `${Math.floor(minutes / 1440)}d${Math.floor((minutes % 1440) / 60)}h`
+}
+
+const Usage = ({ name, value }) => {
+  if (!value) return null
+  const classes = ClassNames.build('spl-claude__usage', {
+    'spl-claude__usage--warn': value.pct >= warnAt && value.pct < dangerAt,
+    'spl-claude__usage--danger': value.pct >= dangerAt
+  })
+  return (
+    <span className={classes}>
+      {name} {value.pct}%
+    </span>
+  )
+}
+
+const Claude = () => {
+  const [output, setOutput] = Uebersicht.React.useState()
+
+  const getClaude = async () => {
+    const json = Json.parse(Output.cleanup(await Uebersicht.run(command)))
+    if (json) setOutput(json)
+  }
+
+  useWidgetRefresh(getClaude, refreshFrequency)
+
+  if (!output) return null
+
+  const { active, others, usage, stale } = output
+  const classes = ClassNames.build('spl-claude', {
+    'spl-claude--permission': active && active.state === 'permission',
+    'spl-claude--stale': stale
+  })
+  const title = usage
+    ? `5h resets in ${formatReset(usage.five.resetsAt)} · 7d resets in ${formatReset(usage.seven.resetsAt)}`
+    : ''
+
+  return (
+    <Widget
+      className={classes}
+      getter={getClaude}
+      onClickCommand={onClickCommand}
+      refreshOnClick={refreshOnClick}
+      style={{ color }}
+    >
+      <span className="spl-claude__icon">✻</span>
+      {active && (
+        <span className="spl-claude__activity">
+          {active.label} {formatElapsed(active.elapsed)}
+          {others > 0 && ` +${others}`}
+        </span>
+      )}
+      {usage && (
+        <span className="spl-claude__usages" title={title}>
+          <Usage name="5h" value={usage.five} />
+          <Usage name="7d" value={usage.seven} />
+        </span>
+      )}
+    </Widget>
+  )
+}
+
+export default Claude
